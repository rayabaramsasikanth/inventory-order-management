# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_TIME_ZONE=Asia/Kolkata

# Database: keep SQLite until Phase 2 is complete. PostgreSQL is optional later.
DATABASE_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
# DATABASE_ENGINE=postgresql
DATABASE_NAME=replace-me
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# Authentication and email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
FRONTEND_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# API security
API_ANON_RATE=120/hour
API_USER_RATE=1200/hour
LOGIN_RATE=5/minute
REGISTRATION_RATE=5/hour
PASSWORD_RESET_RATE=5/hour
CORS_ALLOWED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=False

# Order and idempotency policies
ORDER_RESERVATION_TTL_MINUTES=30
IDEMPOTENCY_TTL_SECONDS=86400

# Phase 3: leave REDIS_URL empty until Redis is provisioned.
# Example local Redis: redis://127.0.0.1:6379/0
# Example managed Redis: rediss://<endpoint>:6379/0
REDIS_URL=
REDIS_KEY_PREFIX=inventory_api
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=
LOW_STOCK_REPORT_EMAIL=
DAILY_ORDER_REPORT_EMAIL=
